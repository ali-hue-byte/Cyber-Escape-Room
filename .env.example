# MICROSOFT AZURE AI FOUNDRY CONFIGURATION
# Required for Microsoft IQ intelligence layer API calls.
# Grab these from your Azure AI Studio Project Dashboard.
AZURE_AI_FOUNDRY_ENDPOINT="https://your-resource-name.services.azure.com/"
AZURE_AI_FOUNDRY_KEY="your_actual_microsoft_foundry_secret_api_key"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
